# finDeck AI — Environment Configuration

# Optional MongoDB Connection String
# finDeck will automatically detect and sync students, credentials, and payment ledgers
# to your MongoDB database if MONGODB_URI is provided.
# If left commented or empty, finDeck runs with high-performance local persistent reactive state.
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/feewise_db?retryWrites=true&w=majority

# Next.js Port (Default 3000)
PORT=3000
